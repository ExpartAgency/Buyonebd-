# GEMINI_API_KEY: Required for Gemini AI API calls (AI Support, AI Content Generator, AI Sales Assistant).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# STEADFAST_API_KEY: Optional Steadfast Courier API Key for live shipment creation & tracking
STEADFAST_API_KEY=STEADFAST_SANDBOX_KEY
STEADFAST_SECRET_KEY=STEADFAST_SANDBOX_SECRET

# PATHAO_CLIENT_ID: Optional Pathao Courier API credentials
PATHAO_CLIENT_ID=PATHAO_SANDBOX_CLIENT_ID

# REDX_API_TOKEN: Optional RedX Courier API token
REDX_API_TOKEN=REDX_SANDBOX_TOKEN

# BKASH_APP_KEY: Optional bKash Tokenized Checkout API Key
BKASH_APP_KEY=BKASH_SANDBOX_APP_KEY

# NAGAD_MERCHANT_ID: Optional Nagad Merchant ID
NAGAD_MERCHANT_ID=NAGAD_SANDBOX_MERCHANT_ID

# SSLCOMMERZ_STORE_ID: Optional SSLCommerz Store ID
SSLCOMMERZ_STORE_ID=SSLCOMMERZ_SANDBOX_STORE_ID

# META_PIXEL_ID & META_CAPI_TOKEN: Optional Meta Pixel & Conversions API credentials
META_PIXEL_ID=META_PIXEL_ID_PLACEHOLDER
META_CAPI_TOKEN=META_CAPI_TOKEN_PLACEHOLDER
